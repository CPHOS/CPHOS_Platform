# CPHOS Docker Compose 模板：复制为 docker-compose.yml 后修改密钥/域名
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: cphos
      POSTGRES_USER: cphos
      POSTGRES_PASSWORD: CHANGE_ME_DB_PASSWORD
    volumes:
      - cphos-db:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U cphos -d cphos']
      interval: 5s
      timeout: 3s
      retries: 20

  api:
    build:
      context: .
      dockerfile: deploy/docker/Dockerfile.api
    depends_on:
      db:
        condition: service_healthy
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      ALLOW_PUBLIC_BIND: 'true'
      PORT: 3001
      DATABASE_URL: postgresql://cphos:CHANGE_ME_DB_PASSWORD@db:5432/cphos
      JWT_SECRET: CHANGE_ME_STRONG_RANDOM_64
      CODE_SALT: CHANGE_ME_INDEPENDENT_32
      CORS_ORIGIN: https://exam.example.com
      UPLOAD_DIR: /data/uploads
      UPLOAD_MAX_MB: '20'
      PAPER_MAX_PAGES: '50'
      SMTP_HOST: smtp.example.com
      SMTP_PORT: '465'
      SMTP_SECURE: 'true'
      SMTP_USER: no-reply@example.com
      SMTP_PASS: CHANGE_ME_SMTP_PASS
      SMTP_FROM: 'CPHOS 平台 <no-reply@example.com>'
    volumes:
      - cphos-uploads:/data/uploads
    # 首次启动执行 db push；生产发布建议改为受控脚本/备份后执行
    command: sh -c "node_modules/.bin/prisma db push --skip-generate --schema apps/api/prisma/schema.prisma && node apps/api/dist/server.js"

  web:
    build:
      context: .
      dockerfile: deploy/docker/Dockerfile.web
    depends_on:
      - api
    ports:
      - '8080:80'

volumes:
  cphos-db:
  cphos-uploads:
