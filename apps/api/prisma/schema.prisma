// CPHOS 新平台 · 核心数据模型（PostgreSQL / Prisma）
// 设计依据：docs/02_新系统设计.md §6（实体模型草案）
// 原则：认证与授权分离、状态机、审计留痕、外键/唯一约束、BigInt 主键
// 说明：新系统不导入历史数据；字典使用数据库自增 ID，管理员可按功能需要维护。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum UserStatus {
  PENDING // 待审核（含邮箱未验证）
  ACTIVE // 正常
  DISABLED // 已禁用
}

// 账号层级：SUPER_ADMIN（系统初始化、受保护）/ ADMIN（由超管提升）/ CPHOS_MEMBER（内部员工）/ PLATFORM_USER（普通用户）
enum AccountRole {
  SUPER_ADMIN
  ADMIN
  CPHOS_MEMBER
  PLATFORM_USER
  BOT // 机器人/自动化账号
}

enum EmailCodePurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum AuditApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  APPROVE // 审核通过
  REJECT // 审核驳回
  BIND_LEGACY // 认领绑定旧账号
  REQUEST_MATERIAL // 要求补材料
  UNBIND // 解绑/回退
  CREATE_ACCOUNT // 创建内部账号
  ROLE_CHANGE // 账号层级变更（提升/降级）
  STATUS_CHANGE // 账号状态变更（启用/禁用）
  MEMBER_UPDATE // 成员资料修改
  TEAM_CREATE // 创建团队
  TEAM_UPDATE // 更新团队
  TEAM_DELETE // 删除团队
  EXAM_CREATE // 创建考试批次
  EXAM_UPDATE // 更新考试
  EXAM_CONFIG // 更新考试配置
  EXAM_PUBLISH // 发布考试
  EXAM_CLOSE // 结束考试
  EXAM_ARCHIVE // 归档考试
  STUDENT_CREATE // 新增学生
  STUDENT_UPDATE // 更新学生
  STUDENT_DELETE // 归档学生
  PAPER_CREATE // 创建整卷
  PAPER_PAGE_ADD // 添加物理答题卡页
  PAPER_QUESTION_BIND // 绑定/调整题目图片
  PAPER_READY // 整卷标记完成
  PAPER_ARCHIVE // 归档整卷
  PAPER_REVIEW_COUNT // 调整整卷评阅次数
  ALLOCATION_CREATE // 创建分配批次
  ALLOCATION_REVOKE // 撤销分配批次
  ALLOCATION_REGRADE // 已定稿重分/重开
  BOT_CREATE // 创建机器人账号
  BOT_TOKEN_ROTATE // 轮换机器人令牌
  MARK_TASK_GRADE // 阅卷打分
  ARBITRATION_CREATE // 创建仲裁任务
  ARBITRATION_CLAIM // 认领仲裁任务
  ARBITRATION_GRADE // 仲裁打分
  RANKING_EXPORT // 导出成绩排名
  DICT_CREATE // 新增字典项
  DICT_UPDATE // 修改字典项
  DICT_DELETE // 删除字典项
}

enum MemberRole {
  LEADER // 负责人
  COACH // 附属教练（仲裁已改为功能模块，不再是身份）
}

// 考试状态机：草稿 -> 已发布 -> 已结束 -> 已归档
enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

// ---------- 认证域 ----------

model UserAccount {
  id                  BigInt      @id @default(autoincrement())
  email               String?     @unique // 仅平台用户/已绑定邮箱账号有（登录+验证码）；内部账号可为 NULL
  loginName           String?     @unique // 内部账号用户名（小写规范化）；平台用户为 NULL
  displayName         String? // 显示名称（内部账号建档时填写）
  emailVerifiedAt     DateTime?
  passwordHash        String?
  // 会话版本：改密/重置/禁用时 +1，用于让旧 refresh token 立即失效
  tokenVersion        Int         @default(0)
  role                AccountRole @default(PLATFORM_USER)
  protected           Boolean     @default(false) // 唯一超级管理员：不可删除/禁用/降级
  status              UserStatus  @default(PENDING)
  legacyMemberId      BigInt?     @unique // 认领绑定的旧平台成员 id（单向一次性）
  // 机器人/自动化账号：哈希存储，不保存明文
  botTokenHash        String?     @unique
  botTokenCreatedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  emailCodes    EmailCode[]
  refreshTokens RefreshToken[]
  applications      AuditApplication[]
  profile           MemberProfile?
  ledTeam           Team?              @relation("TeamLeader")
  createdExams      Exam[]             @relation("ExamCreator")
  allocationBatches AllocationBatch[]
  markRecords       MarkRecord[]
  arbitrations      Arbitration[]
}

model EmailCode {
  id            BigInt           @id @default(autoincrement())
  email         String
  codeHash      String // sha256(email|code|salt)，不存明文
  purpose       EmailCodePurpose
  expiresAt     DateTime
  attempts      Int              @default(0)
  consumedAt    DateTime?
  // 注册验证码绑定的候选密码 hash：verifyEmail 只应用被核销验证码对应的密码
  pendingPasswordHash String?
  createdAt     DateTime         @default(now())
  userAccount   UserAccount?     @relation(fields: [userAccountId], references: [id])
  userAccountId BigInt?

  @@index([email, purpose, createdAt])
  @@index([userAccountId])
}

model RefreshToken {
  id        BigInt      @id @default(autoincrement())
  userId    BigInt
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String      @unique // sha256 存储
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedAt    DateTime?
  tokenVersion Int         @default(0) // 签发时的用户会话版本
  createdAt    DateTime    @default(now())

  @@index([userId])
}

// ---------- 审核域 ----------

model AuditApplication {
  id                    BigInt                 @id @default(autoincrement())
  userId                BigInt
  user                  UserAccount            @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName              String
  schoolId              BigInt?
  school                School?                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  wechatNickname        String?
  contact               String?
  applyNote             String?
  claimLegacy           Boolean                @default(false)
  status                AuditApplicationStatus @default(PENDING)
  matchedLegacyMemberId BigInt?
  reviewerId            BigInt?
  reviewRemark          String?
  reviewedAt            DateTime?
  materialRequestedAt   DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  materials AuditMaterial[]

  @@index([status, createdAt])
  @@index([schoolId])
}

model AuditMaterial {
  id            BigInt           @id @default(autoincrement())
  applicationId BigInt
  application   AuditApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          Int              @default(1) // 1 证明图片 2 其他附件
  fileKey       String
  createdAt     DateTime         @default(now())
}

model AuditLog {
  id             BigInt      @id @default(autoincrement())
  applicationId  BigInt?
  operatorId     BigInt
  action         AuditAction
  legacyMemberId BigInt?
  targetUserId   BigInt? // 账号/团队管理类操作的目标对象
  examId         BigInt? // 考试管理类操作的目标考试
  studentId      BigInt? // 学生名册类操作的目标学生
  remark         String?
  createdAt      DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([examId, createdAt])
  @@index([studentId, createdAt])
  @@index([action, createdAt])
}

// ---------- 业务用户域 ----------

model MemberProfile {
  id          BigInt      @id @default(autoincrement())
  userId      BigInt      @unique
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName    String?
  schoolId    BigInt?
  school      School?     @relation(fields: [schoolId], references: [id])
  role        MemberRole  @default(LEADER)
  teamId      BigInt?
  team        Team?       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  defaultSlot Int? // 默认批阅槽位 1~10
  uploadLimit Int         @default(100)
  auditStatus Int         @default(0) // 0 待审核 1 已通过（对齐旧平台语义）
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  students       Student[]
  uploadedPapers Paper[]
  allocationItems AllocationItem[]
  markingTasks    MarkingTask[]

  @@index([schoolId])
  @@index([teamId])
}

model Team {
  id          BigInt      @id @default(autoincrement())
  name        String
  uploadLimit Int         @default(100) // 团队共享上传限额（一场考试内成员共享）
  leaderId    BigInt      @unique // 一个成员最多担任一个团队的负责人（并发兜底）
  leader      UserAccount @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members MemberProfile[] @relation("TeamMembers")
}

// ---------- 考试域：M2-A 考试批次 / 考试配置 / 学生名册 ----------

model Exam {
  id          BigInt     @id @default(autoincrement())
  name        String
  description String?
  status      ExamStatus @default(DRAFT)
  createdById BigInt
  createdBy   UserAccount @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  closedAt    DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  config ExamConfig?

  papers            Paper[]
  allocationBatches AllocationBatch[]

  @@index([status, createdAt])
}

model ExamConfig {
  id           BigInt   @id @default(autoincrement())
  examId       BigInt   @unique
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  // 不再区分理论/实验：一场考试只有槽位/题目对象数量
  slotCount    Int      @default(8)
  // 每题默认评阅次数（普通管理员不得低于 2，超管可下调）
  reviewCount  Int      @default(2)
  defaultPoint Decimal  @default(0) @db.Decimal(8, 2)
  gap          Decimal  @default(0) @db.Decimal(8, 2)
  // 槽位/页面标题/题号/每题分值映射；理论/实验可通过两场考试分别发布
  titleMapping Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id         BigInt    @id @default(autoincrement())
  ownerId    BigInt
  owner      MemberProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  schoolId   BigInt?
  school     School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  gradeId    BigInt?
  grade      Grade?    @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  prizeId    BigInt?
  prize      Prize?    @relation(fields: [prizeId], references: [id], onDelete: SetNull)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  papers Paper[]

  @@index([ownerId, archivedAt])
  @@index([name])
  @@index([schoolId])
  @@index([gradeId])
  @@index([prizeId])
}

// ---------- 考试域：M2-B 整卷 / 物理页 / 逻辑题 / 题目图片 ----------

enum PaperStatus {
  UPLOADING
  READY
  ARCHIVED
}

enum AllocationStatus {
  ACTIVE
  REVOKED
}

enum MarkingTaskStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum MarkTaskType {
  MARKING
  ARBITRATION
}

enum ArbitrationStatus {
  PENDING
  CLAIMED
  COMPLETED
  CANCELED
}

model Paper {
  id           BigInt      @id @default(autoincrement())
  examId       BigInt
  exam         Exam        @relation(fields: [examId], references: [id], onDelete: Restrict)
  studentId    BigInt
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  uploadedById BigInt
  uploadedBy   MemberProfile @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  status       PaperStatus @default(UPLOADING)
  // 逐卷覆盖评阅次数；null=继承考试 reviewCount
  requiredReviewCount Int?
  score        Decimal?    @db.Decimal(10, 2)
  finalizedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  pages     PaperPage[]
  questions PaperQuestion[]

  @@unique([examId, studentId])
  @@index([examId, status])
  @@index([studentId])
  @@index([uploadedById])
}

model PaperPage {
  id        BigInt   @id @default(autoincrement())
  paperId   BigInt
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  pageNo    Int
  fileKey   String
  // 对象存储元数据；旧数据可为 null，读取时回退 fileKey
  objectId  String?  @unique
  object    StoredObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  questionImages QuestionImage[]

  @@unique([paperId, pageNo])
  @@index([paperId])
}

model PaperQuestion {
  id            BigInt   @id @default(autoincrement())
  paperId       BigInt
  paper         Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  slot          Int
  questionLabel String?
  maxScore      Decimal  @default(0) @db.Decimal(8, 2)
  finalScore    Decimal? @db.Decimal(8, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images       QuestionImage[]
  markingTasks MarkingTask[]
  arbitration  Arbitration?

  @@unique([paperId, slot])
  @@index([paperId])
}


// ---------- 对象存储：filesystem-backed object store（对齐 Question_DB） ----------
model StoredObject {
  id           String   @id @default(uuid())
  fileName     String
  mimeType     String?
  sizeBytes    Int
  contentHash  String // sha256 hex
  storagePath  String   @unique // 相对 UPLOAD_DIR，如 papers/<id>/<uuid>.png
  // 兼容未来从 BYTEA 迁移的历史内容；新对象为 null
  legacyContent Bytes?
  createdAt    DateTime @default(now())

  pages PaperPage[]

  @@index([contentHash])
  @@index([storagePath])
}

model QuestionImage {
  id              BigInt   @id @default(autoincrement())
  paperQuestionId BigInt
  paperQuestion   PaperQuestion @relation(fields: [paperQuestionId], references: [id], onDelete: Cascade)
  paperPageId     BigInt
  paperPage       PaperPage     @relation(fields: [paperPageId], references: [id], onDelete: Cascade)
  // 一道题在同一页/多页中的第几段，用于一题多片段
  partIndex       Int      @default(0)
  // 可选裁剪区域：{x,y,width,height}
  crop            Json?
  fileKey         String?
  createdAt       DateTime @default(now())

  @@unique([paperQuestionId, paperPageId, partIndex])
  @@index([paperQuestionId])
  @@index([paperPageId])
}

model AllocationBatch {
  id          BigInt           @id @default(autoincrement())
  examId      BigInt
  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Restrict)
  status      AllocationStatus @default(ACTIVE)
  createdById BigInt
  createdBy   UserAccount      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  revokedAt   DateTime?

  items AllocationItem[]
  tasks MarkingTask[]

  @@index([examId, createdAt])
}

model AllocationItem {
  id         BigInt          @id @default(autoincrement())
  batchId    BigInt
  batch      AllocationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slot       Int
  assigneeId BigInt
  assignee   MemberProfile   @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  taskCount  Int
  createdAt  DateTime        @default(now())

  @@unique([batchId, slot, assigneeId])
  @@index([batchId])
  @@index([assigneeId])
}

model MarkingTask {
  id              BigInt            @id @default(autoincrement())
  paperQuestionId BigInt
  paperQuestion   PaperQuestion     @relation(fields: [paperQuestionId], references: [id], onDelete: Cascade)
  allocationId    BigInt?
  allocation      AllocationBatch?  @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  roundNo         Int
  assigneeId      BigInt
  assignee        MemberProfile     @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  status          MarkingTaskStatus @default(PENDING)
  score           Decimal?          @db.Decimal(8, 2)
  remark          String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // 同一题同一轮允许多次历史分配；仅当前 ACTIVE 批次的任务生效
  @@unique([allocationId, paperQuestionId, roundNo])
  @@unique([allocationId, paperQuestionId, assigneeId])
  @@index([paperQuestionId, roundNo])
  @@index([assigneeId, status])
  @@index([allocationId])
  @@index([paperQuestionId])
}

model MarkRecord {
  id         BigInt       @id @default(autoincrement())
  taskType   MarkTaskType
  taskId     BigInt
  operatorId BigInt
  operator   UserAccount  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  score      Decimal?     @db.Decimal(8, 2)
  remark     String?
  createdAt  DateTime     @default(now())

  @@index([taskType, taskId])
  @@index([operatorId, createdAt])
}

model Arbitration {
  id              BigInt            @id @default(autoincrement())
  paperQuestionId BigInt            @unique
  paperQuestion   PaperQuestion     @relation(fields: [paperQuestionId], references: [id], onDelete: Cascade)
  status          ArbitrationStatus @default(PENDING)
  claimedById     BigInt?
  claimedBy       UserAccount?      @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  score           Decimal?          @db.Decimal(8, 2)
  remark          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([claimedById])
}

// ---------- 主数据字典（新系统自增 ID，管理员维护） ----------

model Area {
  id      BigInt   @id @default(autoincrement())
  name    String   @unique
  schools School[]
}

model School {
  id           BigInt             @id @default(autoincrement())
  name         String
  // 个人/特殊保护学校：不可改名/移区，阅卷分配排除
  isIndividual Boolean            @default(false)
  areaId       BigInt
  area         Area               @relation(fields: [areaId], references: [id])
  members      MemberProfile[]
  applications AuditApplication[]
  students     Student[]

  @@unique([name, areaId])
  @@index([areaId])
}

model Grade {
  id       BigInt    @id @default(autoincrement())
  name     String    @unique
  students Student[]
}

model Prize {
  id       BigInt    @id @default(autoincrement())
  name     String    @unique
  students Student[]
}

model Topic {
  id   BigInt @id @default(autoincrement())
  name String @unique
}

// ---------- 老用户认领参照快照（可选兼容功能，不主动导入历史数据） ----------

model LegacyMemberRef {
  id             BigInt    @id @default(autoincrement())
  realName       String?
  wechatNickname String?
  wechatAvatar   String?
  schoolId       BigInt?
  auditStatus    Int?
  roleType       Int?
  defaultTopicId Int?
  uploadLimit    Int?
  createdAt      DateTime?

  @@index([realName])
  @@index([wechatNickname])
  @@index([schoolId])
}
