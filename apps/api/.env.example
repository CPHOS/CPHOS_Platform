# 运行环境：development / test / production（生产必须显式设置）
NODE_ENV=development
# 服务端口
PORT=3001
# 监听地址：生产建议 127.0.0.1（Nginx 反代）
HOST=0.0.0.0
# 生产默认拒绝 0.0.0.0；容器等确需公网监听时显式打开
ALLOW_PUBLIC_BIND=false
# 生产默认要求 CORS 为 HTTPS；仅内网/预发可显式允许 HTTP
ALLOW_INSECURE_HTTP=false
# 数据库（开发默认 = 内嵌 PostgreSQL；生产请改为正式实例）
DATABASE_URL=postgresql://cphos:cphos@127.0.0.1:54329/cphos
# JWT 签名密钥：生产必须替换为强随机值，且不能使用公开默认值
# 生成示例（任选其一）：
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me-0123456789abcdef
# 访问令牌有效期（fastify-jwt 格式，如 15m / 1h）
ACCESS_TOKEN_TTL=15m
# 刷新令牌有效期（天）
REFRESH_TOKEN_TTL_DAYS=30
# 邮箱验证码
CODE_TTL_MINUTES=10
# 验证码哈希盐：生产必须替换为独立强随机值，不要与 JWT_SECRET 相同
CODE_SALT=dev-code-salt-change-me
# 允许的跨域来源（逗号分隔；生产填正式域名）
CORS_ORIGIN=http://localhost:5173
# 本地开发上传目录（生产应替换为对象存储）
UPLOAD_DIR=.uploads
# 对象存储驱动：当前 local；未来可接 s3/minio
OBJECT_STORAGE_DRIVER=local
# 上传/请求体上限与反向代理信任
UPLOAD_MAX_MB=20
PAPER_MAX_PAGES=50
BODY_LIMIT_MB=1
TRUST_PROXY=false
# 全局限流
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW='1 minute'
# SMTP（可选）：配置后走真实发信；不配置则开发模式写入 .devmail/ 并打印验证码
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=xxxxxxxx
# SMTP_FROM=CPHOS 平台 <no-reply@example.com>