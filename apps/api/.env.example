# 运行环境：development / test / production（生产必须显式设置）
NODE_ENV=development
# 服务端口
PORT=3001
# 数据库（开发默认 = 内嵌 PostgreSQL；生产请改为正式实例）
DATABASE_URL=postgresql://cphos:cphos@127.0.0.1:54329/cphos
# JWT 签名密钥：生产必须替换为强随机值，且不能使用公开默认值
# 生成示例（任选其一）：
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me-0123456789abcdef
# 访问令牌有效期（fastify-jwt 格式，如 15m / 1h）
ACCESS_TOKEN_TTL=15m
# 刷新令牌有效期（天）
REFRESH_TOKEN_TTL_DAYS=30
# 邮箱验证码
CODE_TTL_MINUTES=10
# 验证码哈希盐：生产必须替换为独立强随机值，不要与 JWT_SECRET 相同
CODE_SALT=dev-code-salt-change-me
# 允许的跨域来源（逗号分隔）
CORS_ORIGIN=http://localhost:5173
# SMTP（可选）：配置后走真实发信；不配置则开发模式写入 .devmail/ 并打印验证码
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=xxxxxxxx
# SMTP_FROM=CPHOS 平台 <no-reply@example.com>