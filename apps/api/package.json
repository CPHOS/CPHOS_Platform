{
  "name": "@cphos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:db-push:e2e": "prisma db push --accept-data-loss",
    "init-super-admin": "tsx scripts/init-super-admin.ts",
    "create-internal": "tsx scripts/create-internal.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@cphos/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "nodemailer": "^6.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "embedded-postgres": "16.14.0-beta.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
