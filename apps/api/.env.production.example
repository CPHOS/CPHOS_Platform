# CPHOS API 生产环境模板（复制为 apps/api/.env 后填真实值）
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
ALLOW_PUBLIC_BIND=false
ALLOW_INSECURE_HTTP=false
# 正式 PostgreSQL 实例；禁止使用开发内嵌库
DATABASE_URL=postgresql://cphos:CHANGE_ME@127.0.0.1:5432/cphos
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CODE_TTL_MINUTES=10
# 独立于 JWT_SECRET
CODE_SALT=CHANGE_ME_INDEPENDENT_SALT
CORS_ORIGIN=https://exam.example.com
UPLOAD_DIR=/var/lib/cphos/uploads
UPLOAD_MAX_MB=20
PAPER_MAX_PAGES=50
BODY_LIMIT_MB=1
TRUST_PROXY=true
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW='1 minute'
# 生产必须配置 SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM='CPHOS 平台 <no-reply@example.com>'
