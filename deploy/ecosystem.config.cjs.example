// PM2 模板：复制为 ecosystem.config.cjs 后按实际路径修改
// API 通过 src/env.ts 显式加载 apps/api/.env，无需依赖 shell 或 PM2 env_file
module.exports = {
  apps: [
    {
      name: 'cphos-api',
      cwd: '/var/www/cphos',
      script: 'apps/api/dist/server.js',
      instances: 1, // 多实例时 @fastify/rate-limit 需 Redis 共享
      exec_mode: 'fork',
      max_memory_restart: '512M',
      kill_timeout: 10000,
      wait_ready: true,
      listen_timeout: 10000,
      out_file: '/var/log/cphos/api.out.log',
      error_file: '/var/log/cphos/api.err.log',
      merge_logs: true,
      env: {
        NODE_ENV: 'production',
      },
    },
  ],
};
